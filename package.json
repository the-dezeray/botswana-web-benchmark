{
  "name": "bw-site-metrics",
  "version": "1.0.0",
  "description": "Web performance auditor for Botswana company websites",
  "main": "audit-resumable.js",
  "bin": {
    "bw-site-metrics": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "config.js",
    "audit-resumable.js",
    "audit-zero-scores.js",
    "sites.json"
  ],
  "scripts": {
    "audit": "node audit-resumable.js --sites sites.json --runs 3 --out results.json",
    "audit:5runs": "node audit-resumable.js --sites sites.json --runs 5 --out results.json",
    "audit:quick": "node audit-resumable.js --sites sites.json --runs 1 --out results_quick.json",
    "audit:quick:parallel": "node audit-resumable.js --sites sites.json --runs 1 --out results_quick.json --concurrency 3",
    "audit:quick:playwright": "bash ./run_quick_audit.sh",
   "audit:zero-scores": "node audit-zero-scores.js --sites sites.json --runs 1 --out results.json",
    "update-data": "node update-data.js",
    "postaudit:quick": "npm run update-data",
    "postaudit:quick:parallel": "npm run update-data"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.0.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "puppeteer": "^25.2.0"
  }
}
